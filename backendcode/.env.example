# Environment Variables Template
# Copy this file to .env and fill in your actual values

# MongoDB Configuration
# Get your MongoDB Atlas connection string from: https://cloud.mongodb.com
# It should look like: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
MONGO_URI=

# JWT Configuration (Must be at least 32 characters)
JWT_SECRET=

# JWT Expiration (milliseconds, 3600000 = 1 hour)
JWT_EXPIRATION_MILLIS=3600000

# Email Configuration (Gmail)
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@runmappro.com

